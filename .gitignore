# Secrets — never commit
.env

# Portal mode's local sqlite fallback store (created by `python -m fireflyer.portal`
# when no DATABASE_URL is set)
portal.db

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store

# Local agent/editor config
.claude/

# Local dataset object store (Parquet + YAML metadata, generated/uploaded)
/data/

# Local "paths" — dashboards you write live here. Keep your own dashboards in
# their own git repo, not this one. (The `demo` path is the tracked demo/
# folder, mapped in by compose; it is deliberately NOT ignored.)
/paths/
