# Copy to .env and fill in to enable the editor's AI assistant.

# Claude (the default provider). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Or OpenAI: uncomment the provider and set its key.
# FIREFLYER_AI_PROVIDER=openai
# OPENAI_API_KEY=

# The model. Required for OpenAI; for Claude the default is claude-sonnet-5-5.
# FIREFLYER_AI_MODEL=
